apiVersion: v1
baseDomain: {{ base_domain }}
metadata:
  name: {{ cluster_name }}
compute:
  - name: worker
    architecture: amd64
    hyperthreading: Enabled
    replicas: {{ ocp_workers | length }}
controlPlane:
  name: master
  architecture: amd64
  hyperthreading: Enabled
  replicas: {{ ocp_masters | length }}
networking:
  networkType: {{ cni }}
  machineNetwork:
    - cidr: {{ machine_network }}
  clusterNetwork:
    - cidr: {{ cluster_network }}
      hostPrefix: 23
  serviceNetwork:
    - {{ service_network }}
platform:
{% if ocp_install_method == 'external' %}
  # No VIPs on platform External: api/api-int/*.apps point at the load
  # balancer (external_lb_address) or, for SNO, at the node itself.
  external:
    platformName: {{ external_platform_name }}
    cloudControllerManager: External
{% elif ocp_is_sno %}
  none: {}
{% else %}
  baremetal:
    apiVIPs:
      - {{ api_vip }}
    ingressVIPs:
      - {{ ingress_vip }}
{% endif %}
pullSecret: '{{ ocp_pull_secret }}'
sshKey: '{{ lookup("ansible.builtin.file", ssh_pubkey_file) | trim }}'
