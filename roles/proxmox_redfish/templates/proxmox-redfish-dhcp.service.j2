[Unit]
Description=DHCP for Shiftmox autoscale workers, all environments (static leases only)
After=network-online.target
Wants=network-online.target

[Service]
RuntimeDirectory=proxmox-redfish-dhcp
ExecStartPre={{ proxmox_redfish_dnsmasq }} --test --conf-file=/dev/null --conf-dir={{ proxmox_redfish_dhcp_dir }},*.conf
ExecStart={{ proxmox_redfish_dnsmasq }} --keep-in-foreground --conf-file=/dev/null --conf-dir={{ proxmox_redfish_dhcp_dir }},*.conf --user=nobody --group={{ 'nogroup' if ansible_os_family == 'Debian' else 'nobody' }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
