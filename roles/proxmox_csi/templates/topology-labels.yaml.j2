{# Puts topology.kubernetes.io/region + zone on every node (installed nodes and
   autoscale workers) - what the CCM would do on platform External. #}
{%- set ns = namespace(lines=[]) -%}
{%- for n in ocp_nodes + autoscale_pool -%}
{%-   set ns.lines = ns.lines + [n.name ~ ' ' ~ n.pve_node] -%}
{%- endfor -%}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: proxmox-topology-labels
  namespace: {{ proxmox_csi_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: proxmox-topology-labels
rules:
  - apiGroups: [""]
    resources: [nodes]
    verbs: [get, list, patch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: proxmox-topology-labels
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: proxmox-topology-labels
subjects:
  - kind: ServiceAccount
    name: proxmox-topology-labels
    namespace: {{ proxmox_csi_namespace }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: proxmox-topology-labels
  namespace: {{ proxmox_csi_namespace }}
data:
  # <node name> <Proxmox node>
  zones: |
{% for l in ns.lines %}
    {{ l }}
{% endfor %}
  label.sh: |
    #!/bin/bash
    # Label nodes that are missing (or have a wrong) region/zone.
    set -u
    while read -r name zone; do
      [ -n "$name" ] || continue
      cur="$(oc get node "$name" -o 'jsonpath={.metadata.labels.topology\.kubernetes\.io/region} {.metadata.labels.topology\.kubernetes\.io/zone}' 2>/dev/null)" || continue
      [ "$cur" = "$REGION $zone" ] && continue
      oc label node "$name" "topology.kubernetes.io/region=$REGION" "topology.kubernetes.io/zone=$zone" --overwrite
    done < /config/zones
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: proxmox-topology-labels
  namespace: {{ proxmox_csi_namespace }}
spec:
  schedule: "*/2 * * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 0
      activeDeadlineSeconds: 110
      template:
        spec:
          serviceAccountName: proxmox-topology-labels
          restartPolicy: Never
          nodeSelector:
            node-role.kubernetes.io/master: ""
          tolerations:
            - key: node-role.kubernetes.io/master
              operator: Exists
              effect: NoSchedule
          containers:
            - name: label
              image: {{ proxmox_csi_cli_image }}
              command: [/bin/bash, /config/label.sh]
              env:
                - name: HOME
                  value: /tmp
                - name: REGION
                  value: {{ proxmox_region | to_json }}
              resources:
                requests: {cpu: 10m, memory: 64Mi}
                limits: {memory: 256Mi}
              securityContext:
                allowPrivilegeEscalation: false
                capabilities: {drop: [ALL]}
                runAsNonRoot: true
                seccompProfile: {type: RuntimeDefault}
              volumeMounts:
                - {name: config, mountPath: /config}
          volumes:
            - name: config
              configMap: {name: proxmox-topology-labels}
